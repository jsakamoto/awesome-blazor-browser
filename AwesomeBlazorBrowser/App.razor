<div class="header-pane">
    <AppBar EnableSearchBox="@(!Loading)"
            OnChangeKeywords="OnChangeKeywords"
            OnClickGroupPanelMenu="OnClickGroupPanelMenu"
            OnClickSettings="OnClickSettings" />
</div>

@if (this.Loading)
{
    <div class="loading-mask">
        <div class="loading">Loading...</div>
    </div>
}

<div class="left-pane @CssClass(new{GroupPanelExpanded})">
    <GroupsPanel Group="RootGroup" OnChangeGroupState="OnChangeGroupState" OnClickGroupLink="OnClickGroupLink" />
</div>

<div class="right-pane @CssClass(new{SettingsPanelExpanded})">
    <Settings />
</div>

<div class="main">
    <Contents Groups="RootGroup.SubGroups" />
</div>

<div class="main-mask @CssClass(new{GroupPanelExpanded, SettingsPanelExpanded})" @onclick="OnClickMainMask">
</div>

<div class="footer-pane">
    <Footer />
</div>
